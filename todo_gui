import tkinter as tk
from tkinter import ttk, messagebox
import json
import os

# File to store tasks
FILE_NAME = "tasks.json"

tasks = []


# Load saved tasks
def load_tasks():
    global tasks

    if os.path.exists(FILE_NAME):
        try:
            with open(FILE_NAME, "r") as file:
                tasks = json.load(file)
        except (json.JSONDecodeError, OSError):
            tasks = []
    else:
        tasks = []

    display_tasks()


# Save tasks
def save_tasks():
    with open(FILE_NAME, "w") as file:
        json.dump(tasks, file, indent=4)


# Display tasks in the list
def display_tasks():
    task_list.delete(0, tk.END)

    for index, task in enumerate(tasks):
        if task["completed"]:
            status = "✓ Completed"
        else:
            status = "○ Pending"

        task_list.insert(
            tk.END,
            f"{index + 1}. {task['name']}   |   {status}"
        )


# Add a new task
def add_task():
    task_name = task_entry.get().strip()

    if task_name == "":
        messagebox.showwarning(
            "Warning", "Please enter a task!"
        )
        return

    tasks.append({
        "name": task_name,
        "completed": False
    })

    save_tasks()
    display_tasks()

    task_entry.delete(0, tk.END)


# Mark selected task as completed
def complete_task():
    selected = task_list.curselection()

    if not selected:
        messagebox.showwarning(
            "Warning", "Please select a task!"
        )
        return

    index = selected[0]
    tasks[index]["completed"] = True

    save_tasks()
    display_tasks()


# Delete selected task
def delete_task():
    selected = task_list.curselection()

    if not selected:
        messagebox.showwarning(
            "Warning", "Please select a task!"
        )
        return

    index = selected[0]

    confirm = messagebox.askyesno(
        "Confirm Delete",
        "Are you sure you want to delete this task?"
    )

    if confirm:
        tasks.pop(index)
        save_tasks()
        display_tasks()


# Create main window
root = tk.Tk()
root.title("My To-Do List Application")
root.geometry("650x550")
root.configure(bg="#F3F0FF")
root.resizable(False, False)


# Application heading
title = tk.Label(
    root,
    text="MY TO-DO LIST",
    font=("Arial", 24, "bold"),
    bg="#F3F0FF",
    fg="#5B3CC4"
)
title.pack(pady=20)


subtitle = tk.Label(
    root,
    text="Organize your day, one task at a time!",
    font=("Arial", 11),
    bg="#F3F0FF",
    fg="#666666"
)
subtitle.pack()


# Task entry section
entry_frame = tk.Frame(root, bg="#F3F0FF")
entry_frame.pack(pady=25)

task_entry = tk.Entry(
    entry_frame,
    font=("Arial", 12),
    width=35,
    bd=2,
    relief="groove"
)
task_entry.pack(side=tk.LEFT, padx=5)

add_button = tk.Button(
    entry_frame,
    text="Add Task",
    font=("Arial", 10, "bold"),
    bg="#6C4CCF",
    fg="white",
    width=12,
    command=add_task
)
add_button.pack(side=tk.LEFT, padx=5)

task_entry.bind("<Return>", lambda event: add_task())


# Task list section
list_frame = tk.Frame(root, bg="white")
list_frame.pack(padx=30, pady=10, fill=tk.BOTH)

task_list = tk.Listbox(
    list_frame,
    font=("Arial", 12),
    width=65,
    height=12,
    selectmode=tk.SINGLE,
    bd=0,
    activestyle="none",
    bg="white",
    fg="#333333",
    selectbackground="#D9CCFF"
)
task_list.pack(padx=10, pady=10)


# Action buttons
button_frame = tk.Frame(root, bg="#F3F0FF")
button_frame.pack(pady=20)

complete_button = tk.Button(
    button_frame,
    text="✓ Complete",
    font=("Arial", 10, "bold"),
    bg="#2E9D70",
    fg="white",
    width=14,
    command=complete_task
)
complete_button.pack(side=tk.LEFT, padx=8)

delete_button = tk.Button(
    button_frame,
    text="Delete Task",
    font=("Arial", 10, "bold"),
    bg="#E05252",
    fg="white",
    width=14,
    command=delete_task
)
delete_button.pack(side=tk.LEFT, padx=8)


# Footer
footer = tk.Label(
    root,
    text="Your productivity starts here!",
    font=("Arial", 10, "italic"),
    bg="#F3F0FF",
    fg="#777777"
)
footer.pack(pady=10)


# Load existing tasks when application starts
load_tasks()

# Run application
root.mainloop()

